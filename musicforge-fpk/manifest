appname=musicforge
version=0.10.0
display_name="MusicForge"
desc="本地音乐库整理工具：格式迁移（QMC/KWM 插件独立分发）、重复清理、整理、歌词补全。零网络、本地优先、绝不改源。"
platform=x86
source=thirdparty

maintainer="simenty"
maintainer_url=https://github.com/simenty/MusicForge

os_min_version=0.9.0
size=15
labels=工具,音乐,本地服务

# 端口由桌面入口 ui/config JSON 的 port 字段声明（对照 Hermes-Studio 已验证形态）；
# 不设 service_port/checkport（checkport 探测时序与 server 启动不同步，反致初始化异常）。
ctl_stop=true

# web 入口型应用标志（缺此字段 fnOS 桌面初始化事件失败——B25 真机实证对照官方样例）
micro_app=true

desktop_uidir=ui
desktop_applaunchname=musicforge.Application